---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/sections/HeroSection.astro';
import ProjectsSection from '../components/sections/ProjectsSection.astro';
import ExperienceSection from '../components/sections/ExperienceSection.astro';
import SkillsSection from '../components/sections/SkillsSection.astro';
import BlogSection from '../components/sections/BlogSection.astro';

const description = 'Developer with a passion for building modern web applications.';
---

<BaseLayout
  title="Isaac Tsienyane — Developer"
  description={description}
>
  <HeroSection />
  <ProjectsSection />
  <ExperienceSection />
  <SkillsSection />
  <BlogSection />
</BaseLayout>

<script>
  import { initScrollReveal } from '../scripts/scroll-reveal';

  document.addEventListener('astro:page-load', initScrollReveal);
  initScrollReveal();
</script>
